---
---
<header class="w-full">
  <div class="mx-auto flex flex-col items-center md:max-w-5xl">
    <div class="md:px-4 w-full">
      <!-- Botón menú móvil -->
      <div class="md:hidden pl-4 pt-4">
        <button type="button" aria-label="Menú" class="text-white cursor-pointer p-1">
          <svg stroke="currentColor" fill="currentColor" stroke-width="0" viewBox="0 0 512 512" class="h-5 w-5" height="1em" width="1em" xmlns="http://www.w3.org/2000/svg">
            <path d="M32 96v64h448V96H32zm0 128v64h448v-64H32zm0 128v64h448v-64H32z"></path>
          </svg>
        </button>
      </div>

      <!-- Menú Desktop -->
      <nav class="hidden w-full justify-center items-center gap-0 bg-transparent md:flex">
        <div class="flex items-center">
          <a class="px-3 text-xl font-normal transition-colors text-foreground hover:text-white" href="/">Calculadora</a>
          <svg stroke="currentColor" fill="currentColor" stroke-width="0" viewBox="0 0 256 256" class="text-neutral-600" height="36" width="36"><path d="M136,24V232a8,8,0,0,1-16,0V24a8,8,0,0,1,16,0Z"></path></svg>
        </div>
        <div class="flex items-center">
          <a class="px-3 text-xl font-normal transition-colors text-slate-400 hover:text-white" href="/tasas">Tasas</a>
          <svg stroke="currentColor" fill="currentColor" stroke-width="0" viewBox="0 0 256 256" class="text-neutral-600" height="36" width="36"><path d="M136,24V232a8,8,0,0,1-16,0V24a8,8,0,0,1,16,0Z"></path></svg>
        </div>
       
      </nav>

      <!-- Logos -->
      <div class="mx-auto flex justify-center">
        <img class="hidden mx-auto mt-10 md:flex" width="350" alt="al cambio logo" src="/logo-horizontal.png" />
        <img class="flex mx-auto md:hidden mt-4" width="150" alt="al cambio logo" src="/logo.png" />
      </div>
    </div>
  </div>
</header>
<!-- Este script carga solo en PC (728x90) -->
<div class="ad-pc">
    <script is:inline>
        atOptions = {
            'key' : 'ed4f2b59ccc9d2731aa1e753f2d55f9c',
            'format' : 'iframe',
            'height' : 90,
            'width' : 728,
            'params' : {}
        };
    </script>
    <script is:inline src="https://www.highrevenueformat.com/ed4f2b59ccc9d2731aa1e753f2d55f9c/invoke.js"></script>
</div>

<!-- Este script carga solo en Móvil (300x250) -->
<div class="ad-mobile">
    <script is:inline>
        atOptions = {
            'key' : 'cfa6e6033ef31aac4e1df2aea9db5fda',
            'format' : 'iframe',
            'height' : 250,
            'width' : 300,
            'params' : {}
        };
    </script>
    <script is:inline src="https://www.highrevenueformat.com/cfa6e6033ef31aac4e1df2aea9db5fda/invoke.js"></script>
</div>

<style>
    /* Estilo básico para centrar */
    .ad-pc, .ad-mobile { 
        display: flex; 
        justify-content: center; 
        margin: 20px 0; 
        min-height: 90px; /* Evita que el layout salte */
        overflow: hidden;
    }

    /* Lógica: Esconder/Mostrar según el tamaño */
    @media (max-width: 768px) {
        .ad-pc { display: none !important; }
        .ad-mobile { display: flex !important; }
    }

    @media (min-width: 769px) {
        .ad-pc { display: flex !important; }
        .ad-mobile { display: none !important; }
    }
</style>
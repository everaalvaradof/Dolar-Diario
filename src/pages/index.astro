---
import Layout from '../layouts/Layout.astro';
import Ad from '../components/Ad.astro';
---

<Layout>
  <main class="container">
    <!-- Botón de instalación -->
    <div id="install-container" class="install-container hidden" style="margin-bottom: 1rem; text-align: center;">
      <button id="install-btn" class="install-btn" style="background: #2563eb; color: white; border: none; padding: 0.6rem 1.2rem; border-radius: 9999px; font-weight: 600; cursor: pointer; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.1);">
        📱 Instalar App en el Teléfono
      </button>
    </div>

    <!-- Tarjeta principal de la calculadora (Área de captura) -->
    <div class="calculator-card">
      <!-- Selector de Tasa -->
      <div class="rate-selector-wrapper">
        <button id="rate-btn" class="rate-btn">
          <span id="current-rate-name">Cargando tasa...</span>
          <span class="dropdown-icon">⋮</span>
        </button>
        
        <div id="rate-dropdown" class="rate-dropdown hidden">
          <button data-type="bcv_usd">Dólar BCV</button>
          <button data-type="bcv_eur">Euro BCV</button>
          <button data-type="usdt_avg">Binance P2P (USDT)</button>
        </div>
      </div>

      <!-- Input de Moneda Extranjera -->
      <div class="input-group">
        <label id="symbol-ext" for="input-ext">$</label>
        <input type="text" id="input-ext" value="1,00" inputmode="decimal" />
        <button class="copy-btn" id="copy-ext" title="Copiar valor">📋</button>
      </div>

      <!-- Input de Bolívares -->
      <div class="input-group">
        <label for="input-bs">Bs</label>
        <input type="text" id="input-bs" value="0,00" inputmode="decimal" />
        <button class="copy-btn" id="copy-bs" title="Copiar valor">📋</button>
      </div>

      <!-- Botón para Restablecer a 1 -->
      <div style="text-align: center; margin-top: 1rem; margin-bottom: 0.5rem;">
        <button id="clear-all-btn" class="clear-all-btn">
          🔄 Restablecer a 1
        </button>
      </div>

      <!-- Indicador de Fecha y Hora -->
      <div class="card-footer-info">
        <div class="info-box variation-box">
          <span id="rate-date-label" class="variation neutral">Actualizado: ---</span>
        </div>
      </div>
    </div>
    
    <Ad />

    <!-- Tarjeta de Brecha Cambiaria -->
    <div class="brecha-card">
      <span>Brecha: <strong id="brecha-value">--%</strong> ↑</span>
    </div>

    <!-- Botón de Compartir Captura -->
    <div style="text-align: center; margin-top: 1rem;">
      <button id="share-screenshot-btn" class="whatsapp-share-btn" style="background: #0284c7;">
        📸 Compartir Imagen / Captura
      </button>
    </div>
  </main>

  <script>
    interface RateData {
      bcv_usd?: number;
      bcv_eur?: number;
      usdt_avg?: number;
      brecha_usdt_usd?: number;
      brecha_usdt_eur?: number;
      [key: string]: any;
    }

    let currentActiveRecord: RateData | null = null;
    let activeRateType: keyof typeof rateConfig = 'bcv_usd';

    const rateBtn = document.getElementById('rate-btn');
    const rateDropdown = document.getElementById('rate-dropdown');
    const currentRateName = document.getElementById('current-rate-name');
    const inputExt = document.getElementById('input-ext') as HTMLInputElement;
    const inputBs = document.getElementById('input-bs') as HTMLInputElement;
    const symbolExt = document.getElementById('symbol-ext');
    const rateDateLabel = document.getElementById('rate-date-label');
    const brechaValue = document.getElementById('brecha-value');

    const rateConfig = {
      bcv_usd: { name: 'Dólar BCV', symbol: '$' },
      bcv_eur: { name: 'Euro BCV', symbol: '€' },
      usdt_avg: { name: 'Binance P2P (USDT)', symbol: '$' }
    };

    // --- LÓGICA DE INSTALACIÓN PWA ---
    let deferredPrompt: any = null;
    const installContainer = document.getElementById('install-container');
    const installBtn = document.getElementById('install-btn');

    window.addEventListener('beforeinstallprompt', (e) => {
      e.preventDefault();
      deferredPrompt = e;
      if (installContainer) installContainer.classList.remove('hidden');
    });

    if (installBtn) {
      installBtn.addEventListener('click', async () => {
        if (!deferredPrompt) return;
        deferredPrompt.prompt();
        deferredPrompt = null;
        if (installContainer) installContainer.classList.add('hidden');
      });
    }

    // --- FUNCIONES DE FORMATEO (Puntos para miles, coma para decimales) ---
    function formatNum(num: number): string {
      return new Intl.NumberFormat('es-VE', {
        minimumFractionDigits: 2,
        maximumFractionDigits: 2
      }).format(num);
    }

    function parseNum(str: string): number {
      if (!str) return 0;
      const clean = str.replace(/\./g, '').replace(',', '.');
      const val = parseFloat(clean);
      return isNaN(val) ? 0 : val;
    }

    function getDateTime(includeTime = false): string {
      const now = new Date();
      const fecha = now.toLocaleDateString('es-VE', { day: '2-digit', month: '2-digit', year: 'numeric' });
      if (includeTime) {
        const hora = now.toLocaleTimeString('es-VE', { hour: '2-digit', minute: '2-digit', second: '2-digit', hour12: true });
        return `${fecha} - ${hora}`;
      }
      return fecha;
    }

    async function initLatest(): Promise<void> {
      try {
        const resPrices = await fetch('https://www.brecha-cambiaria.com/api/prices');
        const dataPrices: RateData = await resPrices.json();
        currentActiveRecord = dataPrices;
        applyRateData(currentActiveRecord);
      } catch (e) {
        console.error("Error al conectar con la API", e);
        if (currentRateName) currentRateName.innerText = "Error de conexión";
      }
    }

    function applyRateData(record: RateData | null): void {
      if (!record) return;

      if (currentRateName) currentRateName.innerText = rateConfig[activeRateType].name;
      if (symbolExt) symbolExt.innerText = rateConfig[activeRateType].symbol;

      const currentRate = Number(record[activeRateType]) || 0;
      const extVal = parseNum(inputExt?.value || '1,00');
      
      if (inputBs) {
        inputBs.value = formatNum(extVal * currentRate);
      }

      if (brechaValue) {
        if (activeRateType === 'bcv_eur') {
          const bEur = record.brecha_usdt_eur !== undefined ? record.brecha_usdt_eur : 0;
          brechaValue.innerText = `${formatNum(Number(bEur))}%`;
        } else if (activeRateType === 'usdt_avg') {
          brechaValue.innerText = `0,00%`;
        } else {
          const bUsd = record.brecha_usdt_usd !== undefined ? record.brecha_usdt_usd : 0;
          brechaValue.innerText = `${formatNum(Number(bUsd))}%`;
        }
      }

      const showTime = (activeRateType === 'usdt_avg');
      if (rateDateLabel) {
        rateDateLabel.innerText = `Actualizado: ${getDateTime(showTime)}`;
      }
    }

    // --- MANEJO DE INPUTS (Edición limpia y formato al salir con blur) ---
    if (inputExt) {
      inputExt.addEventListener('focus', () => {
        const rawVal = parseNum(inputExt.value);
        inputExt.value = rawVal === 0 ? '' : rawVal.toString();
        inputExt.select();
      });

      inputExt.addEventListener('input', () => {
        if (!currentActiveRecord) return;
        const currentRate = Number(currentActiveRecord[activeRateType]) || 0;
        const val = parseNum(inputExt.value);
        if (inputBs) {
          inputBs.value = formatNum(val * currentRate);
        }
      });

      inputExt.addEventListener('blur', () => {
        const val = parseNum(inputExt.value);
        inputExt.value = formatNum(val);
      });
    }

    if (inputBs) {
      inputBs.addEventListener('focus', () => {
        const rawVal = parseNum(inputBs.value);
        inputBs.value = rawVal === 0 ? '' : rawVal.toString();
        inputBs.select();
      });

      inputBs.addEventListener('input', () => {
        if (!currentActiveRecord) return;
        const currentRate = Number(currentActiveRecord[activeRateType]) || 1;
        const val = parseNum(inputBs.value);
        if (inputExt && currentRate > 0) {
          inputExt.value = formatNum(val / currentRate);
        }
      });

      inputBs.addEventListener('blur', () => {
        const val = parseNum(inputBs.value);
        inputBs.value = formatNum(val);
      });
    }

    // Restablecer a 1
    const clearAllBtn = document.getElementById('clear-all-btn');
    if (clearAllBtn) {
      clearAllBtn.addEventListener('click', () => {
        if (inputExt) inputExt.value = '1,00';
        if (currentActiveRecord) {
          const currentRate = Number(currentActiveRecord[activeRateType]) || 0;
          if (inputBs) inputBs.value = formatNum(currentRate);
        }
        if (inputExt) {
          inputExt.focus();
          inputExt.select();
        }
      });
    }

    if (rateBtn && rateDropdown) {
      rateBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        rateDropdown.classList.toggle('hidden');
      });

      window.addEventListener('click', () => {
        rateDropdown.classList.add('hidden');
      });

      rateDropdown.querySelectorAll('button').forEach(btn => {
        btn.addEventListener('click', (e) => {
          const target = e.currentTarget as HTMLElement | null;
          const dataType = target?.getAttribute('data-type');
          if (dataType && (dataType === 'bcv_usd' || dataType === 'bcv_eur' || dataType === 'usdt_avg')) {
            activeRateType = dataType;
            applyRateData(currentActiveRecord);
          }
        });
      });
    }

    const copyExtBtn = document.getElementById('copy-ext');
    if (copyExtBtn && inputExt) {
      copyExtBtn.addEventListener('click', () => {
        navigator.clipboard.writeText(inputExt.value);
      });
    }

    const copyBsBtn = document.getElementById('copy-bs');
    if (copyBsBtn && inputBs) {
      copyBsBtn.addEventListener('click', () => {
        navigator.clipboard.writeText(inputBs.value);
      });
    }

    // LÓGICA DE COMPARTIR CAPTURA
    const shareScreenshotBtn = document.getElementById('share-screenshot-btn');
    const captureArea = document.querySelector('.calculator-card');

    if (shareScreenshotBtn && captureArea) {
      shareScreenshotBtn.addEventListener('click', async () => {
        try {
          const originalText = shareScreenshotBtn.innerHTML;
          shareScreenshotBtn.innerHTML = '📸 Generando imagen...';
          shareScreenshotBtn.setAttribute('disabled', 'true');

          // @ts-ignore
          const canvas = await html2canvas(captureArea, {
            backgroundColor: '#121212',
            scale: 2,
            useCORS: true
          });

          canvas.toBlob(async (blob: Blob | null) => {
            if (!blob) {
              shareScreenshotBtn.innerHTML = originalText;
              shareScreenshotBtn.removeAttribute('disabled');
              return;
            }

            const file = new File([blob], 'dolar-diario.png', { type: 'image/png' });

            if (navigator.canShare && navigator.canShare({ files: [file] })) {
              await navigator.share({
                files: [file],
                title: 'Dolar Diario',
                text: 'Tasas actuales en Dolar Diario 🚀'
              });
            } else {
              const link = document.createElement('a');
              link.download = 'dolar-diario.png';
              link.href = canvas.toDataURL('image/png');
              link.click();
            }

            shareScreenshotBtn.innerHTML = originalText;
            shareScreenshotBtn.removeAttribute('disabled');
          }, 'image/png');

        } catch (error) {
          console.error('Error al capturar:', error);
          shareScreenshotBtn.innerHTML = '📸 Compartir Imagen / Captura';
          shareScreenshotBtn.removeAttribute('disabled');
        }
      });
    }

    initLatest();
  </script>
</Layout>
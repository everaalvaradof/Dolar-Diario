---
import Layout from '../layouts/Layout.astro';
import Ad from '../components/Ad.astro';
---

<Layout title="Tasas Actuales - Dolar Hoy">
  <main class="container">
    <!-- Logo o Título de la sección -->
    <div class="logo-wrapper">
      <div class="logo-circle">
        <span class="logo-arrow">↕</span>
      </div>
      <span class="logo-text">Dolar Hoy</span>
    </div>

    <!-- Pestañas de Navegación (Tasas BCV / USDT) -->
    <div class="tabs-container">
      <button id="tab-bcv" class="tab-btn active">Tasas BCV</button>
      <button id="tab-usdt" class="tab-btn">Tasas USDT</button>
    </div>

    <!-- Fecha actual y hora -->
    <div class="date-header">
      <span id="current-date-label">Cargando fecha...</span>
      <span id="current-time-label" class="hidden"> - <span id="time-usdt-header">--:--</span></span>
    </div>

    <!-- Contenedor Vista BCV -->
    <div id="view-bcv" class="rates-view">
      <div class="rates-list">
        <div class="rate-row">
          <span class="rate-name">Dólar BCV</span>
          <div class="rate-values">
            <span id="val-bcv-usd" class="rate-price">-- Bs</span>
            <span class="rate-change neutral">Oficial</span>
          </div>
        </div>
        <div class="rate-row">
          <span class="rate-name">Euro BCV</span>
          <div class="rate-values">
            <span id="val-bcv-eur" class="rate-price">-- Bs</span>
            <span class="rate-change neutral">Oficial</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Contenedor Vista USDT -->
    <div id="view-usdt" class="rates-view hidden">
      <div class="rates-list">
        <div class="rate-row">
          <span class="rate-name">Binance P2P (Promedio)</span>
          <div class="rate-values">
            <span id="val-usdt-avg" class="rate-price">-- Bs</span>
            <span id="var-usdt-brecha" class="rate-change neutral">Brecha: --%</span>
          </div>
        </div>
      </div>
    </div>

    <Ad />
  </main>

  <script>
    const tabBcv = document.getElementById('tab-bcv');
    const tabUsdt = document.getElementById('tab-usdt');
    const viewBcv = document.getElementById('view-bcv');
    const viewUsdt = document.getElementById('view-usdt');
    const currentDateLabel = document.getElementById('current-date-label');
    const currentTimeLabel = document.getElementById('current-time-label');
    const timeUsdtHeader = document.getElementById('time-usdt-header');

    // Cambiar entre pestañas
    tabBcv.addEventListener('click', () => {
      tabBcv.classList.add('active');
      tabUsdt.classList.remove('active');
      viewBcv.classList.remove('hidden');
      viewUsdt.classList.add('hidden');
      currentTimeLabel.classList.add('hidden');
    });

    tabUsdt.addEventListener('click', () => {
      tabUsdt.classList.add('active');
      tabBcv.classList.remove('active');
      viewUsdt.classList.remove('hidden');
      viewBcv.classList.add('hidden');
      currentTimeLabel.classList.remove('hidden');
    });

    // Cargar datos de la API
    async function fetchRates() {
      try {
        const res = await fetch('https://www.brecha-cambiaria.com/api/prices');
        const data = await res.json();

        // Asignar valores BCV
        if (data.bcv_usd) {
          document.getElementById('val-bcv-usd').innerText = `${Number(data.bcv_usd).toFixed(2)} Bs`;
        }
        if (data.bcv_eur) {
          document.getElementById('val-bcv-eur').innerText = `${Number(data.bcv_eur).toFixed(2)} Bs`;
        }

        // Asignar valores USDT
        if (data.usdt_avg) {
          document.getElementById('val-usdt-avg').innerText = `${Number(data.usdt_avg).toFixed(2)} Bs`;
        }
        if (data.brecha_usdt_usd !== undefined) {
          document.getElementById('var-usdt-brecha').innerText = `Brecha: ${Number(data.brecha_usdt_usd).toFixed(2)}%`;
        }

        // Extraer fecha y hora desde el timestamp de la API si existe
        if (data.timestamp) {
          const dateObj = new Date(data.timestamp);
          const dateOptions: Intl.DateTimeFormatOptions = { 
            weekday: 'long', 
            day: '2-digit', 
            month: '2-digit', 
            year: 'numeric' 
          };
          let formattedDate = dateObj.toLocaleDateString('es-VE', dateOptions);
          formattedDate = formattedDate.charAt(0).toUpperCase() + formattedDate.slice(1);
          currentDateLabel.innerText = formattedDate;

          const timeOptions: Intl.DateTimeFormatOptions = { 
            hour: '2-digit', 
            minute: '2-digit',
            hour12: true 
          };
          timeUsdtHeader.innerText = dateObj.toLocaleTimeString('es-VE', timeOptions);
        } else {
          // Fallback a la hora local si no viene en el JSON
          const now = new Date();
          currentDateLabel.innerText = now.toLocaleDateString('es-VE');
          timeUsdtHeader.innerText = now.toLocaleTimeString('es-VE', { hour: '2-digit', minute: '2-digit', hour12: true });
        }

      } catch (e) {
        console.error("Error al cargar tasas", e);
        currentDateLabel.innerText = "Error al conectar";
      }
    }

    fetchRates();
  </script>
</Layout>
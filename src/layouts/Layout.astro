---
// src/layouts/Layout.astro
import '../styles/global.css';

interface Props {
  title?: string;
}

const { title = "Dolar Diario - Calculadora de Tasas Venezuela" } = Astro.props;
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#121212" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    
    <title>{title}</title>

    <script async src="https://www.googletagmanager.com/gtag/js?id=G-D5X29EW7GG"></script>
    <script>
      // @ts-ignore
      window.dataLayer = window.dataLayer || [];
      // @ts-ignore
      function gtag(){dataLayer.push(arguments);}
      // @ts-ignore
      gtag('js', new Date());
      // @ts-ignore
      gtag('config', 'G-D5X29EW7GG');
    </script>
  </head>
  <body>
    <header class="navbar">
      <div class="nav-content">
        <!-- Izquierda: Menú Hamburguesa y Enlaces -->
        <div class="nav-left">
          <button id="menu-toggle" class="menu-toggle" aria-label="Abrir menú">
            <span></span>
            <span></span>
            <span></span>
          </button>
          
          <nav id="nav-menu">
            <a href="/" class="active">Calculadora</a>
            <a href="/tasas">Tasas</a>
          </nav>
        </div>

        <!-- Centro: Logo exactamente igual al del index pero posicionado en la navbar -->
        <a href="/" class="logo-wrapper nav-brand-center">
          <div class="logo-circle">
            <span class="logo-arrow">↕</span>
          </div>
          <span class="logo-text">Dolar Hoy</span>
        </a>

        <!-- Derecha: Botón de Compartir -->
        <button id="share-btn" class="share-btn" aria-label="Compartir aplicación" title="Compartir Dolar Diario">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="18" cy="5" r="3"></circle>
            <circle cx="6" cy="12" r="3"></circle>
            <circle cx="18" cy="19" r="3"></circle>
            <line x1="8.59" y1="13.51" x2="15.42" y2="17.49"></line>
            <line x1="15.41" y1="6.51" x2="8.59" y2="10.49"></line>
          </svg>
        </button>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <p>
        Tasas actualizadas gracias a la API de 
        <a href="https://www.brecha-cambiaria.com/" target="_blank" rel="noopener noreferrer">Brecha Cambiaria</a>.
      </p>
    </footer>

    <script>
      const menuToggle = document.getElementById('menu-toggle');
      const navMenu = document.getElementById('nav-menu');

      if (menuToggle && navMenu) {
        menuToggle.addEventListener('click', (e) => {
          e.stopPropagation();
          navMenu.classList.toggle('show');
        });

        window.addEventListener('click', (e) => {
          if (!navMenu.contains(e.target as Node) && !menuToggle.contains(e.target as Node)) {
            navMenu.classList.remove('show');
          }
        });
      }

      const shareBtn = document.getElementById('share-btn');
      if (shareBtn) {
        shareBtn.addEventListener('click', async () => {
          const shareData = {
            title: 'Dolar Diario',
            text: 'Calcula y convierte al instante las tasas del Dólar BCV y Binance P2P en Venezuela.',
            url: window.location.href,
          };

          if (navigator.share) {
            try {
              await navigator.share(shareData);
              return;
            } catch (err: any) {
              if (err.name === 'AbortError') return;
            }
          }

          try {
            await navigator.clipboard.writeText(window.location.href);
            alert('¡Enlace copiado al portapapeles!');
          } catch (err) {
            console.error('Error al copiar enlace:', err);
          }
        });
      }

      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register('/sw.js')
            .catch(err => console.log('Error al registrar el Service Worker:', err));
        });
      }
    </script>

    <script>
      window.addEventListener('DOMContentLoaded', () => {
        if (!sessionStorage.getItem('visit_notified')) {
          const token = '8951220952:AAEZ6VmRmPw6hPcbRrh8WjNu4BDqI_Kar5o';
          const chat_id = '540332548';
          const mensaje = '¡Alguien entró a Dolar Diario! 🚀';
          
          const url = `https://api.telegram.org/bot${token}/sendMessage?chat_id=${chat_id}&text=${encodeURIComponent(mensaje)}`;
          
          fetch(url)
            .then(response => {
              if (response.ok) {
                sessionStorage.setItem('visit_notified', 'true');
              }
            })
            .catch(error => console.error('Error al notificar:', error));
        }
      });
    </script>
  </body>
</html>
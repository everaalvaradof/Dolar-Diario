---
// src/layouts/Layout.astro
import '../styles/global.css';

interface Props {
  title?: string;
}

const { title = "Dolar Diario - Calculadora de Tasas Venezuela" } = Astro.props;
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    
    <!-- Configuración para PWA / App Móvil -->
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#121212" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    
    <title>{title}</title>

    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-D5X29EW7GG"></script>
    <script>
      // @ts-ignore
      window.dataLayer = window.dataLayer || [];
      // @ts-ignore
      function gtag(){dataLayer.push(arguments);}
      // @ts-ignore
      gtag('js', new Date());

      // @ts-ignore
      gtag('config', 'G-D5X29EW7GG');
    </script>
  </head>
  <body>
    <header class="navbar">
      <div class="nav-content">
        <button id="menu-toggle" class="menu-toggle" aria-label="Abrir menú">
          <span></span>
          <span></span>
          <span></span>
        </button>
        <nav id="nav-menu">
          <a href="/" class="active">Calculadora</a>
          <a href="/tasas">Tasas</a>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <p>
        Tasas actualizadas gracias a la API de 
        <a href="https://www.brecha-cambiaria.com/" target="_blank" rel="noopener noreferrer">Brecha Cambiaria</a>.
      </p>
    </footer>

    <style>
      .site-footer {
        text-align: center;
        padding: 1.5rem 1rem;
        font-size: 0.85rem;
        opacity: 0.8;
        border-top: 1px solid rgba(255, 255, 255, 0.1);
        margin-top: 2rem;
      }
      .site-footer a {
        color: inherit;
        text-decoration: underline;
        font-weight: 500;
      }
    </style>

    <script>
      // Lógica del menú desplegable
      const menuToggle = document.getElementById('menu-toggle');
      const navMenu = document.getElementById('nav-menu');

      if (menuToggle && navMenu) {
        menuToggle.addEventListener('click', (e) => {
          e.stopPropagation();
          navMenu.classList.toggle('show');
        });

        window.addEventListener('click', () => {
          navMenu.classList.remove('show');
        });
      }

      // Registro del Service Worker para PWA
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register('/sw.js')
            .catch(err => console.log('Error al registrar el Service Worker:', err));
        });
      }
    </script>
<script>
  window.addEventListener('DOMContentLoaded', () => {
    // Verificamos si ya le notificamos a Telegram en esta sesión del usuario
    if (!sessionStorage.getItem('visit_notified')) {
      const token = '8951220952:AAEZ6VmRmPw6hPcbRrh8WjNu4BDqI_Kar5o';
      const chat_id = '540332548';
      const mensaje = '¡Alguien entró a Dolar Diario! 🚀';
      
      const url = `https://api.telegram.org/bot${token}/sendMessage?chat_id=${chat_id}&text=${encodeURIComponent(mensaje)}`;
      
      fetch(url)
        .then(response => {
          if (response.ok) {
            // Marcamos que ya se envió la notificación para esta sesión
            sessionStorage.setItem('visit_notified', 'true');
            console.log('Notificación de visita enviada');
          }
        })
        .catch(error => console.error('Error al notificar:', error));
    }
  });
</script>
  </body>
</html>